<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <RootNamespace>ShadowViewer.Plugin.EpubLoader</RootNamespace>
        <PackageId>ShadowViewer.Plugin.EpubLoader</PackageId>
        <PluginName>本地阅读Epub</PluginName>
        <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <UseWinUI>true</UseWinUI>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <MetalamaAllowPreviewLanguageFeatures>true</MetalamaAllowPreviewLanguageFeatures>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <Version>0.2.0</Version>
        <RepositoryUrl>https://github.com/kitUIN/ShadowViewer.Plugin.EpubLoader</RepositoryUrl>
        <Description>使本地阅读器支持epub文件</Description>
        <Authors>kitUIN</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/kitUIN/ShadowViewer.Plugin.EpubLoader</PackageProjectUrl>
        <Copyright>Copyright 2023-2026</Copyright>
        <PackageTags>wasdk;ShadowViewer;plugin;winui</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageOutputPath>..\..\NugetPackages</PackageOutputPath>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <DefaultLanguage>zh-CN</DefaultLanguage>
        <LocalReaderProject Condition="'$(DepsUseNuget)' != 'true' And Exists('..\..\ShadowViewer\ShadowViewer.Plugin.Local\ShadowViewer.Plugin.Local\ShadowViewer.Plugin.Local.csproj')">..\..\ShadowViewer\ShadowViewer.Plugin.Local\ShadowViewer.Plugin.Local\ShadowViewer.Plugin.Local.csproj</LocalReaderProject>
    </PropertyGroup>
    <ItemGroup Label="Dependencies" Condition="'$(LocalReaderProject)' == ''">
        <!-- The host supplies the built-in reader and its runtime resources. -->
        <PackageReference Include="ShadowViewer.Plugin.Local" Version="2.0.1" Need="[2.0,2.1)" ExcludeAssets="contentFiles" />
    </ItemGroup>
    <ItemGroup Condition="'$(LocalReaderProject)' != ''">
        <ProjectReference Include="$(LocalReaderProject)" />
    </ItemGroup>
    <!-- Reader resources are supplied by the host; do not expand its PRI into this plugin. -->
    <Target Name="ExcludeBuiltInReaderResources" BeforeTargets="AddPriPayloadFilesToCopyToOutputDirectoryItems" Condition="'$(LocalReaderProject)' == ''">
        <ItemGroup>
            <_ReferenceRelatedPaths Remove="@(_ReferenceRelatedPaths)" Condition="'%(Filename)%(Extension)' == 'ShadowViewer.Plugin.Local.pri'" />
            <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)%(Extension)' == 'ShadowViewer.Plugin.Local.pri'" />
        </ItemGroup>
    </Target>
</Project>
